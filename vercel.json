{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": { "api/food-events.js": { "maxDuration": 120 }, "api/nudges.js": { "maxDuration": 300 }, "api/guide.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/@:handle", "destination": "/api/creator?h=:handle" },
    { "source": "/u/:handle", "destination": "/api/creator?h=:handle" },
    { "source": "/eat", "destination": "/api/guide" },
    { "source": "/eat/:city", "destination": "/api/guide?city=:city" },
    { "source": "/eat/:city/:food", "destination": "/api/guide?city=:city&food=:food" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(self), geolocation=(self), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.*)\\.(html|js|css|json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(feedbear\\.png|feedbear\\.jpg|feedbear-sm\\.jpg|feedbear-icon\\.png|icon\\.svg|bear-mark\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/digest", "schedule": "0 16 * * 4" },
    { "path": "/api/nudges", "schedule": "0 16 * * *" }
  ]
}
